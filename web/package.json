{
  "name": "seller-lab-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev --turbopack --port 3100",
    "build": "next build && node scripts/stage.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "secrets:live": "node scripts/push-secrets.mjs",
    "deploy:live": "pnpm build && wrangler deploy",
    "test": "node --test lib/ worker/"
  },
  "dependencies": {
    "@livekit/components-react": "^2.9.24",
    "livekit-client": "^2.22.2",
    "livekit-server-sdk": "^2.18.0",
    "next": "15.5.27",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.162.0"
  }
}
