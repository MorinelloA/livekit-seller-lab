# Copy to .env.local in this folder. Both the agent and the lab page read it.
# Values come from your LiveKit Cloud project's settings: the project URL starts
# with wss://, and creating an API key gives you the key and the secret.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Deepgram hears the caller and speaks for all three voices (Juniper, Priya and
# the coach). Free account at console.deepgram.com: Settings, API Keys,
# Create a New API Key. The key is a long string of letters and numbers.
DEEPGRAM_API_KEY=

# The hosted lab (tonyt908.com/livekitlab) and the local page's API.
# LAB_ACCESS_CODE goes in the link you send people; calls need it.
# LAB_ADMIN_CODE opens the pilot results page. Keep it to yourself.
LAB_ACCESS_CODE=
LAB_ADMIN_CODE=
# A local agent registers under its own name, so it never takes the hosted
# lab's calls (the agent on LiveKit Cloud is juniper-lab).
AGENT_NAME=juniper-lab-dev
